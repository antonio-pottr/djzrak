{
	"name": "air",
	"main": "src/index.js",
	"compatibility_date": "2026-09-01",
	// main + assets.directory: static files win for matching paths, the Worker gets the rest.
	"assets": {
		"directory": "./public"
	},
	// src/index.js reads env.DB, so the binding has to be DB.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "air",
			"database_id": "061bc3a8-57d5-4236-bfe5-312bc104d5c0"
		}
	],
	"observability": {
		"enabled": true
	},
	// Drives scheduled() in src/index.js. Every firing refreshes pm25, every sixth refreshes
	// all seven sensors — this schedule is what sets the KV write budget.
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	// src/history.js reads env.KV, so the binding has to be KV.
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "51fa3ad160ac4fdf85608db2e27342d2"
		}
	]
}
